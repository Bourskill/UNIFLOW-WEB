{
  "name": "uniflow-escritorio",
  "productName": "UNIFLOW",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "main": "main.js",
  "description": "UNIFLOW de escritorio: la app y su servidor en esta PC, con los datos en una carpeta (propia o compartida).",
  "author": "UNIFLOW",
  "scripts": {
    "preparar": "node preparar.mjs",
    "iniciar": "npm run preparar && electron .",
    "instalador": "npm run preparar && electron-builder --win"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.116.0",
    "clipper-lib": "^6.4.2",
    "cors": "^2.8.5",
    "dotenv": "^17.4.2",
    "dxf-parser": "^1.1.2",
    "express": "^4.19.2",
    "nanoid": "^5.0.7",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^5.6.205"
  },
  "devDependencies": {
    "electron": "45.2.3",
    "electron-builder": "26.18.0"
  },
  "build": {
    "appId": "com.uniflow.escritorio",
    "productName": "UNIFLOW",
    "asar": false,
    "files": [
      "main.js",
      "package.json",
      "app/**/*",
      "node_modules/**/*"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "shortcutName": "UNIFLOW"
    }
  }
}
