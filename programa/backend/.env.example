SUPABASE_URL=https://tu-proyecto.supabase.co
SUPABASE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxx
# Project Settings > API > "service_role" ("secret" en la UI nueva de Supabase).
# Solo la usa Storage (subir imágenes/PDF) -- salta la RLS que bloquea al key
# de arriba para crear buckets y subir archivos. Nunca sale del backend.
SUPABASE_SERVICE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxx

# Clave que pide la web para entrar (mínimo 12 caracteres). Sin ella el
# backend no arranca -- nunca se sirve la API abierta. Usá una frase larga.
CLAVE_ACCESO=cambia-esta-clave-por-una-larga

# Orígenes del frontend que pueden llamar a la API, separados por coma.
# En Render: la URL de Netlify, ej. https://uniflow-web.netlify.app
ORIGENES_PERMITIDOS=http://localhost:5173
